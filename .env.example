# Copy to .env and adjust.
PORT=3001
# On Botkeep.cloud, set DATABASE_URL in the Environment panel (not in this file).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Example using Botkeep host node10.botkeep.cloud:
# DATABASE_URL=postgres://postgres:your_password@node10.botkeep.cloud:5432/hackersdigest
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackersdigest

# The single operator account: whoever registers this handle is the admin
# (approval-queue access, kill-switch, /admin dashboard).
ADMIN_HANDLE=evobugz
